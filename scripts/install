#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# BUILD THE APPLICATION
#=================================================
ynh_script_progression "Building $app (this can take a while)..."

profilarr_build_app

#=================================================
# DEPLOY THE BUILT APPLICATION
#=================================================
ynh_script_progression "Deploying $app..."

mkdir -p "$install_dir"

#=================================================
# TEMP DIAGNOSTIC - remove once asset 404 is understood
#=================================================
ynh_print_info "DIAG: build_dir=$profilarr_build_dir"
ynh_print_info "DIAG: du -sh build_dir/static"
du -sh "$profilarr_build_dir/static" 2>&1 || true
ynh_print_info "DIAG: find build_dir/static (count + sample)"
find "$profilarr_build_dir/static" 2>&1 | wc -l || true
find "$profilarr_build_dir/static" -maxdepth 3 2>&1 | head -20 || true

cp "$profilarr_build_dir/profilarr" "$install_dir/profilarr"
cp -r "$profilarr_build_dir/static" "$install_dir/static"
chmod 755 "$install_dir/profilarr"
chown -R "$app:www-data" "$install_dir"

ynh_print_info "DIAG: du -sh install_dir/static (post-copy)"
du -sh "$install_dir/static" 2>&1 || true
ynh_print_info "DIAG: find install_dir/static (count + sample, post-copy)"
find "$install_dir/static" 2>&1 | wc -l || true
find "$install_dir/static" -maxdepth 3 2>&1 | head -20 || true

profilarr_cleanup_build

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

# create log directory in data_dir
# (the app writes its own logs to $data_dir/logs via APP_BASE_PATH, this
# symlink makes them show up under the standard /var/log/$app path too)
mkdir -p "/var/log/$app"
chown -R "$app:$app" "/var/log/$app"
chmod 755 "/var/log/$app"
ln -s "/var/log/$app" "$data_dir/logs"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated NGINX config using the conf/nginx.conf template
ynh_config_add_nginx

# Create a dedicated systemd config
ynh_config_add_systemd
yunohost service add "$app" --description="Profilarr backend" --log="/var/log/$app/$app.log"

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate "/var/log/$app/"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start a systemd service
ynh_systemctl --service="$app" --action="start" --wait_until="Server ready" --log_path="/var/log/$app/$app.log"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
