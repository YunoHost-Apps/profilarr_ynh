#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

### Settings are automatically loaded as bash variables
### in every app script context, therefore typically these will exist:
### - $domain
### - $path
### - $language
### - $install_dir
### - $port
### ...

### In the context of upgrade,
### - resources are automatically provisioned / updated / deleted (depending on existing resources)
### - a safety backup is automatically created by the core and will be restored if the upgrade fails

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# RESET APP DATA WHEN UPGRADING FROM V1
#=================================================

# Profilarr v2 is a complete rewrite (Python/Flask -> Deno/SvelteKit) with a
# different database engine and schema. Per upstream, the v1 database format
# is NOT compatible with v2 and there is no migration path. Data is reset
# once, the first time an install crosses the 1.x -> 2.x boundary; normal
# 2.x -> 2.x upgrades never hit this branch.
if ynh_compare_current_package_version --comparison lt --version 2.0.0~ynh1
then
    ynh_print_warn "Upgrading from Profilarr v1: v2 uses an incompatible database format (confirmed by upstream, no migration exists). Existing data (database, settings, linked arr configs) will be reset. You will need to go through the setup wizard again after the upgrade."
    ynh_safe_rm "$data_dir"
    mkdir -p "$data_dir"
    chown "$app:$app" "$data_dir"
fi

#=================================================
# BUILD THE APPLICATION
#=================================================
ynh_script_progression "Building $app (this can take a while)..."

profilarr_build_app

#=================================================
# DEPLOY THE BUILT APPLICATION
#=================================================
ynh_script_progression "Deploying $app..."

ynh_safe_rm "$install_dir/profilarr"
ynh_safe_rm "$install_dir/static"
cp "$profilarr_build_dir/profilarr" "$install_dir/profilarr"
cp -r "$profilarr_build_dir/static" "$install_dir/static"
chmod 755 "$install_dir/profilarr"
chown -R "$app:www-data" "$install_dir"

profilarr_cleanup_build

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

# Ensure log directory exists with proper permissions
mkdir -p "/var/log/$app"
chown -R "$app:$app" "/var/log/$app"
chmod 755 "/var/log/$app"

# Ensure symbolic link to logs exists (also recreates it after a data reset above)
if [ ! -L "$data_dir/logs" ]; then
    ynh_safe_rm "$data_dir/logs"
    ln -s "/var/log/$app" "$data_dir/logs"
fi

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

### This should be a literal copypaste of what happened in the install's "System configuration" section

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Profilarr backend" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate "/var/log/$app/"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Server ready" --log_path="/var/log/$app/$app.log"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
